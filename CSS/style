* {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: #f4f6f9;
      color: #222;
    }

    .container {
      width: 100%;
      max-width: 760px;
      margin: 0 auto;
      padding: 24px 16px;
    }

    .card {
      background: white;
      padding: 24px;
      border-radius: 16px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    }

    h1 {
      margin-top: 0;
      margin-bottom: 8px;
      text-align: center;
      color: #7b1e3a;
    }

    .subtitle {
      margin-top: 0;
      margin-bottom: 24px;
      text-align: center;
      color: #666;
    }

    label {
      display: block;
      margin-top: 18px;
      margin-bottom: 8px;
      font-weight: bold;
    }

    textarea,
    input,
    select {
      width: 100%;
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-family: inherit;
      font-size: 16px;
    }

    textarea {
      min-height: 170px;
      resize: vertical;
    }

    .character-count {
      margin-top: 6px;
      text-align: right;
      font-size: 13px;
      color: #777;
    }

    .button-area {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 20px;
    }

    button,
    .download-button {
      padding: 12px 18px;
      border: none;
      border-radius: 8px;
      background: #7b1e3a;
      color: white;
      font-size: 16px;
      cursor: pointer;
      text-decoration: none;
    }

    button:disabled {
      background: #999;
      cursor: not-allowed;
    }

    .download-button {
      display: none;
      background: #176b45;
    }

    #status {
      margin-top: 18px;
      color: #555;
      white-space: pre-wrap;
      line-height: 1.5;
    }

    audio {
      display: none;
      width: 100%;
      margin-top: 20px;
    }

    .info {
      margin-top: 20px;
      padding: 12px;
      border-radius: 8px;
      background: #f8f1f4;
      color: #6b2940;
      font-size: 14px;
      line-height: 1.5;
    }
.install-button{display:block;margin:0 auto 18px;background:#176b45;}
